# ============================================================================
# Codialis — front-end statique (Hostinger / Apache)
# Le back-end (API) tourne ailleurs : https://landingback.codialis.com
# ============================================================================

DirectoryIndex index.html

# --- SEO : page 404 personnalisée (statut 404 conservé) ----------------------
ErrorDocument 404 /404.html

# --- MIME du manifeste PWA (favicons) ---------------------------------------
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

# --- URLs propres : /contact -> Contact.dc.html -----------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- SEO : hôte canonique (www -> apex) + HTTPS, uniquement en production --
  RewriteCond %{HTTP_HOST} ^www\.codialis\.com$ [NC]
  RewriteRule ^(.*)$ https://codialis.com/$1 [R=301,L]
  RewriteCond %{HTTP_HOST} ^codialis\.com$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://codialis.com/$1 [R=301,L]

  # --- SEO : évite le contenu dupliqué (fichiers bruts -> URLs propres, 301) --
  RewriteCond %{THE_REQUEST} \s/index\.html [NC]
  RewriteRule ^index\.html$ / [R=301,L]
  RewriteCond %{THE_REQUEST} \s/developpement-saas\.html [NC]
  RewriteRule ^developpement-saas\.html$ /developpement-saas [R=301,L]
  RewriteCond %{THE_REQUEST} \s/application-mobile\.html [NC]
  RewriteRule ^application-mobile\.html$ /application-mobile [R=301,L]
  RewriteCond %{THE_REQUEST} \s/agence-ia\.html [NC]
  RewriteRule ^agence-ia\.html$ /agence-ia [R=301,L]
  RewriteCond %{THE_REQUEST} \s/crm-erp-api\.html [NC]
  RewriteRule ^crm-erp-api\.html$ /crm-erp-api [R=301,L]
  RewriteCond %{THE_REQUEST} \s/Portfolio\.dc\.html [NC]
  RewriteRule ^Portfolio\.dc\.html$ /portfolio [R=301,L]
  RewriteCond %{THE_REQUEST} \s/Blog\.dc\.html [NC]
  RewriteRule ^Blog\.dc\.html$ /blog [R=301,L]
  RewriteCond %{THE_REQUEST} \s/Contact\.dc\.html [NC]
  RewriteRule ^Contact\.dc\.html$ /contact [R=301,L]
  RewriteCond %{THE_REQUEST} \s/Financement\.dc\.html [NC]
  RewriteRule ^Financement\.dc\.html$ /financement [R=301,L]
  RewriteCond %{THE_REQUEST} \s/Legal\.dc\.html [NC]
  RewriteRule ^Legal\.dc\.html$ /legal [R=301,L]

  # Laisser passer les fichiers et dossiers qui existent déjà (assets, .dc.html…)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^developpement-saas/?$  developpement-saas.html  [L]
  RewriteRule ^application-mobile/?$  application-mobile.html  [L]
  RewriteRule ^agence-ia/?$           agence-ia.html           [L]
  RewriteRule ^crm-erp-api/?$         crm-erp-api.html         [L]
  RewriteRule ^portfolio/?$   Portfolio.dc.html   [L]
  RewriteRule ^blog/?$        Blog.dc.html        [L]
  RewriteRule ^contact/?$     Contact.dc.html     [L]
  RewriteRule ^financement/?$ Financement.dc.html [L]
  RewriteRule ^legal/?$       Legal.dc.html       [L]
  RewriteRule ^admin/?$       Admin.dc.html       [L]
</IfModule>

# --- En-têtes de sécurité (remplacent le helmet du back qui servait le site) -
<IfModule mod_headers.c>
  # CSP : le dc-runtime (support.js) charge React/ReactDOM/Babel depuis unpkg et
  # exige 'unsafe-inline'/'unsafe-eval'. connect-src DOIT lister l'API distante,
  # sinon le navigateur bloque chaque fetch vers landingback.codialis.com.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://unpkg.com https://cdn.jsdelivr.net https://assets.calendly.com; script-src-attr 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://assets.calendly.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://landingback.codialis.com https://calendly.com https://cdn.jsdelivr.net; frame-src 'self' https://calendly.com; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Content-Type-Options "nosniff"

  # SEO : pages privées hors index (s'applique aussi via /admin réécrit)
  <FilesMatch "^(Admin|Chatbot)\.dc\.html$">
    Header always set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
</IfModule>

# --- Performance (Core Web Vitals) : cache navigateur ------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType application/manifest+json "access plus 7 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
