# URL interne de l'API backend. Le navigateur ne l'appelle jamais directement :
# seul le serveur Next de frontend-admin s'y adresse, en relayant la session.
BACKEND_URL="http://localhost:3001"

# Laisser vide en production (HTTPS) : le cookie de session est alors `Secure`.
# Mettre "false" uniquement pour consulter une pile locale en HTTP clair depuis
# une AUTRE machine (http://<ip>:3002) — un navigateur y refuserait un cookie
# `Secure` et la connexion boucherait sans message. Sur localhost, inutile.
SESSION_COOKIE_SECURE=""
