# MySQL/MariaDB 10.6+ — mysql://user:password@host:3306/dbname
DATABASE_URL="mysql://user:password@localhost:3306/codialis"

# Any random string — used to sign session cookies.
AUTH_SECRET="change-me-to-a-random-string"

NEXT_PUBLIC_CALENDLY_URL="https://calendly.com/your-org/30min"

# Origines autorisées à appeler /api/* (site vitrine, hébergé séparément).
# Liste séparée par des virgules. Laisser vide = les trois valeurs par défaut
# (https://codialis.com, https://www.codialis.com, http://localhost:3001).
CORS_ORIGINS="https://codialis.com,https://www.codialis.com,http://localhost:3001"

# Get a free key at https://aistudio.google.com/apikey — leave empty to keep
# the template-based drafts on the Remontées client / Automatisations screens.
GOOGLE_API_KEY=""

# --- E-mails transactionnels (Brevo) ---------------------------------------
# Sans clé, aucun e-mail ne part : la création de compte est refusée (elle
# dépend de l'envoi), et les notifications sont simplement journalisées.
BREVO_API_KEY=""
BREVO_SENDER_NAME="Codialis"
# Doit être un expéditeur validé dans le compte Brevo.
BREVO_SENDER_EMAIL="no-reply@codialis.com"
# Logo hébergé, facultatif : sans lui l'en-tête retombe sur un mot-symbole HTML.
BREVO_LOGO_URL=""
# Uniquement pour pointer un bac à sable en test.
BREVO_API_URL=""

# --- URLs utilisées dans les liens des e-mails -----------------------------
ADMIN_URL="https://admin.codialis.com"
SITE_URL="https://codialis.com"
API_URL="https://landingback.codialis.com"
