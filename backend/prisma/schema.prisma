// ---------------------------------------------------------------------------
// Site vitrine (codialis.com)
//
// Le site public est statique et hébergé séparément : il lit ces tables via
// les routes /api/content, /api/settings, /api/newsletter et /api/contact.
//
// Les cinq modèles ci-dessous sont mappés sur les tables de l'ancien backend
// Express (noms snake_case) : la migration qui les crée est un
// `CREATE TABLE IF NOT EXISTS`, donc une base qui contient déjà le contenu du
// site le conserve tel quel — aucune reprise de données à faire.
// ---------------------------------------------------------------------------

// Contenu éditorial du site. La forme de chaque item vit dans `data` (JSON) :
// le site public consomme l'objet à plat (`{ id, views, ...data }`), exactement
// comme il le faisait quand ces objets étaient codés en dur dans les pages.
//   type : portfolio | blog | testimonials
model Content {
  id        String   @id @default(uuid()) @db.Char(36)
  type      String   @db.VarChar(16)
  data      Json
  views     BigInt   @default(0)
  position  BigInt   @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)

  // Composite (type, created_at) : la liste publique filtre par type et trie
  // par created_at. Sans lui MySQL fait un filesort qui bufferise la colonne
  // `data` (JSON) -> ER_OUT_OF_SORTMEMORY.
  @@index([type, createdAt], map: "content_type_created_idx")
  @@map("content")
}

// Réglages de page (hero, cas à la une, logos, réseaux sociaux…), un blob JSON
// par clé stable. `key` est un mot réservé MySQL, d'où les backticks générés.
//   clés : portfolio_page | blog_page | contact_socials | home_logos
model Setting {
  key       String   @id @db.VarChar(191)
  data      Json
  updatedAt DateTime @default(now()) @map("updated_at") @db.DateTime(0)

  @@map("settings")
}

// Compteur de vues par page publique (portfolio, blog).
model PageView {
  page  String @id @db.VarChar(191)
  count BigInt @default(0)

  @@map("page_views")
}

model NewsletterSubscriber {
  id        String   @id @default(uuid()) @db.Char(36)
  email     String   @unique @db.VarChar(320)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)

  @@index([createdAt], map: "newsletter_created_idx")
  @@map("newsletter_subscribers")
}

// Demandes issues du formulaire public /contact.
//   status : nouveau (reçu) | en_cours (pris en charge) | traite (clos)
model ContactRequest {
  id        String   @id @default(uuid()) @db.Char(36)
  name      String   @default("") @db.VarChar(200)
  company   String   @default("") @db.VarChar(200)
  email     String   @default("") @db.VarChar(320)
  phone     String   @default("") @db.VarChar(60)
  project   String   @default("") @db.VarChar(200)
  budget    String   @default("") @db.VarChar(60)
  message   String?  @db.Text
  status    String   @default("nouveau") @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)

  @@index([createdAt], map: "contact_requests_created_idx")
  @@map("contact_requests")
}

// ---------------------------------------------------------------------------
// Veille (curation de flux RSS)
// ---------------------------------------------------------------------------

enum FeedItemStatus {
  NEW
  IGNORED
  LATER
  PUBLISHED
}

// Un article agrégé depuis les flux de `config/feeds.json`. `guid` est
// l'identifiant fourni par le flux : il sert à ne pas réimporter deux fois le
// même article d'un rafraîchissement à l'autre, et à ne jamais réécrire un
// article déjà trié (son statut et sa recatégorisation manuelle survivent).
model FeedItem {
  id          String         @id @default(cuid())
  guid        String         @unique @db.VarChar(512)
  source      String         @db.VarChar(255)
  // Catégorie de veille, plus large que celles du blog : la publication en
  // fait la correspondance (voir src/lib/feeds.ts).
  category    String         @db.VarChar(64)
  title       String         @db.VarChar(512)
  excerpt     String?        @db.Text
  // Corps complet quand le flux le fournit, sinon rempli à l'enrichissement.
  content     String?        @db.MediumText
  image       String?        @db.VarChar(2048)
  link        String         @db.VarChar(1024)
  publishedAt DateTime?
  status      FeedItemStatus @default(NEW)
  fetchedAt   DateTime       @default(now())

  // La liste filtre par statut et trie par date de publication : cet index
  // couvre exactement filtre + tri, donc pas de filesort qui bufferiserait la
  // colonne `excerpt`.
  @@index([status, publishedAt, fetchedAt])
  @@index([category])
}

// ---------------------------------------------------------------------------
// Jetons à usage unique (confirmation d'adresse, réinitialisation)
// ---------------------------------------------------------------------------

enum UserTokenKind {
  VERIFY
  RESET
}

// Seul le SHA-256 du jeton est stocké : le jeton en clair ne voyage que dans le
// lien envoyé par e-mail. Une fuite de la base ne permet donc pas de rejouer
// les liens. `usedAt` marque la consommation — un lien ne sert qu'une fois.
model UserToken {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      UserTokenKind
  tokenHash String        @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([tokenHash])
  @@index([userId])
}
